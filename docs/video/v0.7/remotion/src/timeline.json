  "captions": [
    {
      "from": 18,
      "to": 134,
      "text": "연구 주제가 바뀔 때마다 지침을 새로 써야 할까요?"
    },
    {
      "from": 134,
      "to": 287,
      "text": "교육이든 보건이든, 같은 에이전트가 처음부터 함께 고민해야 합니다."
    },
    {
      "from": 335,
      "to": 441,
      "text": "Research Orchestrator Kit 0.7."
    },
    {
      "from": 441,
      "to": 596,
      "text": "이 저장소의 AGENTS.md가, 주제에 매이지 않는 연구계획서 에이전트입니다."
    },
    {
      "from": 644,
      "to": 756,
      "text": "Codex에서 저장소를 열고 한 문장으로 부릅니다."
    },
    {
      "from": 756,
      "to": 844,
      "text": "에이전트는 계획서를 바로 쓰지 않습니다."
    },
    {
      "from": 844,
      "to": 1033,
      "text": "저장할 수 있는지 먼저 확인하고, 꼭 필요한 질문을 세 개까지 이유와 함께 묻습니다."
    },
    {
      "from": 1081,
      "to": 1206,
      "text": "그다음 서로 다른 연구 방향을 두세 가지 보여 줍니다."
    },
    {
      "from": 1206,
      "to": 1322,
      "text": "장점과 위험을 비교하고, 고르는 것은 연구자입니다."
    },
    {
      "from": 1322,
      "to": 1435,
      "text": "추천을 부탁해도 합의가 아니라 제안으로 남깁니다."
    },
    {
      "from": 1483,
      "to": 1719,
      "text": "연구문제와 자료와 분석이 서로 맞는지 표로 점검하고, 연구자가 명시적으로 동의해야 초안을 씁니다."
    },
    {
      "from": 1719,
      "to": 1816,
      "text": "동의한 문장은 그대로 부록에 인용됩니다."
    },
    {
      "from": 1864,
      "to": 2048,
      "text": "초안은 작업 폴더에 마크다운 파일로 저장되고, 파일이 실제로 있는지 확인합니다."
    },
    {
      "from": 2048,
      "to": 2170,
      "text": "저장하기 전에는 여덟 가지 항목을 스스로 점검합니다."
    },
    {
      "from": 2218,
      "to": 2301,
      "text": "확인하지 않은 문헌은 만들지 않습니다."
    },
    {
      "from": 2301,
      "to": 2501,
      "text": "근거가 필요한 문장에는 미확인 표시를 붙이고, 합의하지 않은 세부는 제안으로 따로 모읍니다."
    },
    {
      "from": 2549,
      "to": 2663,
      "text": "같은 지침으로 두 가상 사례를 시험했습니다."
    },
    {
      "from": 2663,
      "to": 2880,
      "text": "보건교사의 직무 스트레스는 설문 기반 양적 연구로, 중학생 독서토론은 혼합 연구로."
    },
    {
      "from": 2880,
      "to": 2984,
      "text": "질문과 방법이 주제에 맞게 달라졌습니다."
    },
    {
      "from": 3032,
      "to": 3114,
      "text": "더 나아가려면 심화 모드로 잇습니다."
    },
    {
      "from": 3114,
      "to": 3258,
      "text": "저장한 초안을 해시로 가져와 문헌 수집과 독립 검토를 거칩니다."
    },
    {
      "from": 3258,
      "to": 3386,
      "text": "인용한 문장이 그 쪽에 실제로 있을 때만 근거로 셉니다."
    },
    {
      "from": 3434,
      "to": 3469,
      "text": "판단은 연구자에게."
    },
    {
      "from": 3469,
      "to": 3508,
      "text": "실행은 에이전트에게."
    },
    {
      "from": 3508,
      "to": 3599,
      "text": "Research Orchestrator Kit."
    }
  ]
}
