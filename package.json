{
  "name": "research-orchestrator-kit",
  "version": "0.7.1",
  "description": "A Korean-first, evidence-traceable research proposal orchestrator for APA 7, JQI, and generic workflows.",
  "type": "module",
  "bin": {
    "rok": "./src/cli.mjs"
  },
  "files": [
    "src/",
    "profiles/",
    "prompts/",
    "schemas/",
    "docs/*.md",
    "examples/synthetic/README.md",
    "README.md",
    "README.en.md",
    "AGENTS.md",
    "CLAUDE.md",
    "CHANGELOG.md",
    "CITATION.cff",
    "LICENSE",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "config.example.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "demo": "node examples/synthetic/run-demo.mjs && node examples/synthetic-v2/run-demo.mjs",
    "eval": "node scripts/eval-evidence.mjs",
    "audit": "node scripts/audit-public.mjs",
    "verify": "node scripts/verify-release.mjs",
    "pack:check": "node scripts/check-package.mjs",
    "format": "npx --yes prettier@3.3.3 --write \"src/**/*.mjs\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\"",
    "format:check": "npx --yes prettier@3.3.3 --check \"src/**/*.mjs\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\""
  },
  "license": "MIT",
  "keywords": ["research", "proposal", "orchestrator", "apa7", "evidence", "codex", "claude", "korean"],
  "repository": { "type": "git", "url": "git+https://github.com/yangyeontae-blip/research-orchestrator-kit.git" },
  "bugs": { "url": "https://github.com/yangyeontae-blip/research-orchestrator-kit/issues" },
  "homepage": "https://github.com/yangyeontae-blip/research-orchestrator-kit#readme",
  "private": false,
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "docx": "9.9.0",
    "kordoc": "4.21.11",
    "pdfjs-dist": "6.4.299"
  }
}
