{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research brief",
  "type": "object",
  "required": ["schema_version", "project_id", "title", "idea", "profile", "entry_mode", "method", "deadline", "institution_guidance", "sensitive_information", "created_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "workflow_id": { "type": ["string", "null"] },
    "title": { "type": "string", "minLength": 1 },
    "idea": { "type": "string", "minLength": 1 },
    "profile": { "enum": ["apa7", "jqi", "generic"] },
    "entry_mode": { "enum": ["study_then_plan", "direct_plan"] },
    "method": { "type": "string", "minLength": 1 },
    "deadline": { "type": ["string", "null"], "format": "date" },
    "institution_guidance": { "type": "string" },
    "sensitive_information": { "type": "boolean" },
    "apa_paper_type": { "enum": ["student", "professional", "not_applicable"] },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}

